{
  "name": "mongodb-orm-type-safety-comparison",
  "version": "1.0.0",
  "description": "This repository demonstrates the differences in type safety between three popular Node.js ORMs/ODMs for MongoDB: Prisma, Mongoose, and Typegoose.",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "contract:emit": "prisma contract emit",
    "prisma:seed": "tsx --env-file=.env src/prisma/seed.ts",
    "skills:sync": "prisma skills sync || exit 0",
    "postinstall": "prisma skills sync || exit 0",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@swc/core": "^1.15.3",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@vitest/coverage-v8": "^4.0.13",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unicorn": "^62.0.0",
    "prisma": "8.0.0-rc.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "@prisma/orm-mongo": "8.0.0-rc.8",
    "@typegoose/typegoose": "^13.4.0",
    "bcryptjs": "^3.0.3",
    "mongodb": "^7.2.0",
    "mongoose": "^9.9.4",
    "mongoose-autopopulate": "^1.2.1",
    "zod": "^4.1.13"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
