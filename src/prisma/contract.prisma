// use prisma-next

type Address {
  street String
  city   String
  state  String
  zip    String
}

model User {
  id        ObjectId @id @map("_id")
  email     String   @unique
  firstName String
  lastName  String
  address   Address?
  posts     Post[]

  @@map("users")
}

model Post {
  id       ObjectId  @id @map("_id")
  slug     String    @unique
  title    String
  body     String
  authorId ObjectId
  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]

  @@map("posts")
}

model Comment {
  id      ObjectId @id @map("_id")
  comment String
  postId  ObjectId
  post    Post     @relation(fields: [postId], references: [id])

  @@map("comments")
}
